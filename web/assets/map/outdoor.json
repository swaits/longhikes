{
  "version": 8,
  "name": "Long Hikes outdoor",
  "metadata": {
    "olt:about": "The outdoor base map of the trail pages, read by /assets/app.js. Derived from OpenFreeMap Liberty (MIT), itself a fork of OSM Liberty and OSM Bright (BSD-3-Clause code, CC BY 4.0 design); see LICENSE.txt beside this file. Light colours are in each layer's paint; olt:dark holds the same layer's dark-theme paint, and olt:km its layout when the reader puts km and m first.",
    "olt:contours": {
      "ft": {"multiplier": 3.28084, "thresholds": {"11": [500, 2500], "12": [200, 1000], "13": [100, 500], "14": [100, 500], "15": [40, 200]}},
      "m": {"multiplier": 1, "thresholds": {"11": [200, 1000], "12": [100, 500], "13": [50, 250], "14": [20, 100], "15": [10, 50]}}
    }
  },
  "sources": {
    "openmaptiles": {"type": "vector", "url": "https://tiles.openfreemap.org/planet"},
    "olt-dem": {
      "type": "raster-dem",
      "tiles": ["https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"],
      "encoding": "terrarium",
      "tileSize": 512,
      "maxzoom": 12,
      "bounds": [-180, 14, -50, 85],
      "attribution": "Relief: <a href=\"https://registry.opendata.aws/terrain-tiles/\">Terrain Tiles</a>, USGS and others (full credit below the map)"
    },
    "olt-contours": {"type": "vector", "tiles": ["contours://{z}/{x}/{y}"], "minzoom": 11, "maxzoom": 15, "bounds": [-180, 14, -50, 85]}
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {"id": "background", "type": "background",
     "paint": {"background-color": "#f2efe6"},
     "metadata": {"olt:dark": {"background-color": "#1d241f"}}},

    {"id": "landcover-ice", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
     "filter": ["==", ["get", "class"], "ice"],
     "paint": {"fill-color": "#f6fafc", "fill-outline-color": "#bcd6e6"},
     "metadata": {"olt:dark": {"fill-color": "#2a3338", "fill-outline-color": "#3b4d58"}}},
    {"id": "landcover-rock", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
     "filter": ["==", ["get", "class"], "rock"],
     "paint": {"fill-color": "#e3ded4", "fill-antialias": false},
     "metadata": {"olt:dark": {"fill-color": "#2a2b27"}}},
    {"id": "landcover-sand", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
     "filter": ["==", ["get", "class"], "sand"],
     "paint": {"fill-color": "#eee3c3", "fill-antialias": false},
     "metadata": {"olt:dark": {"fill-color": "#2d2a20"}}},
    {"id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
     "filter": ["==", ["get", "class"], "grass"],
     "paint": {"fill-color": "#e2e8cc", "fill-opacity": 0.8, "fill-antialias": false},
     "metadata": {"olt:dark": {"fill-color": "#202a21"}}},
    {"id": "landcover-wetland", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
     "filter": ["==", ["get", "class"], "wetland"],
     "paint": {"fill-color": "#d6e5dc", "fill-antialias": false},
     "metadata": {"olt:dark": {"fill-color": "#1c2b27"}}},
    {"id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
     "filter": ["==", ["get", "class"], "wood"],
     "paint": {"fill-color": "#c6dbb0", "fill-antialias": false,
               "fill-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 8, 0.8, 12, 0.9]},
     "metadata": {"olt:dark": {"fill-color": "#22352a"}}},
    {"id": "landuse-built", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
     "filter": ["match", ["get", "class"], ["residential", "suburb", "neighbourhood", "commercial", "industrial", "retail"], true, false],
     "paint": {"fill-color": "#e3ddd1", "fill-antialias": false,
               "fill-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.9, 14, 0.6]},
     "metadata": {"olt:dark": {"fill-color": "#272b27"}}},
    {"id": "park-fill", "type": "fill", "source": "openmaptiles", "source-layer": "park",
     "filter": ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
     "paint": {"fill-color": "#4f8a46", "fill-antialias": false,
               "fill-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.1, 10, 0.04]},
     "metadata": {"olt:dark": {"fill-color": "#8fd08a"}}},

    {"id": "hillshade", "type": "hillshade", "source": "olt-dem",
     "paint": {"hillshade-shadow-color": "#4f535c", "hillshade-highlight-color": "#fffdf4",
               "hillshade-accent-color": "#5c5a53", "hillshade-illumination-direction": 315,
               "hillshade-exaggeration": ["interpolate", ["linear"], ["zoom"], 3, 0.9, 6, 0.7, 9, 0.5, 12, 0.4, 15, 0.3]},
     "metadata": {"olt:dark": {"hillshade-shadow-color": "#000000", "hillshade-highlight-color": "#5d6b60",
                               "hillshade-accent-color": "#0b0f0d"}}},
    {"id": "contour-minor", "type": "line", "source": "olt-contours", "source-layer": "contours",
     "filter": ["==", ["get", "level"], 0],
     "paint": {"line-color": "rgba(135, 96, 58, 0.32)", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 15, 0.8]},
     "metadata": {"olt:dark": {"line-color": "rgba(214, 186, 146, 0.24)"}}},
    {"id": "contour-major", "type": "line", "source": "olt-contours", "source-layer": "contours",
     "filter": [">", ["get", "level"], 0],
     "paint": {"line-color": "rgba(135, 96, 58, 0.55)", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.8, 15, 1.3]},
     "metadata": {"olt:dark": {"line-color": "rgba(214, 186, 146, 0.42)"}}},
    {"id": "contour-label", "type": "symbol", "source": "olt-contours", "source-layer": "contours",
     "filter": [">", ["get", "level"], 0],
     "layout": {"symbol-placement": "line", "symbol-spacing": 420, "text-max-angle": 25,
                "text-field": ["concat", ["number-format", ["get", "ele"], {"locale": "en-US"}], " ft"],
                "text-font": ["Noto Sans Regular"], "text-size": 10, "text-padding": 4},
     "paint": {"text-color": "#86643f", "text-halo-color": "rgba(242, 239, 230, 0.9)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#b89d77", "text-halo-color": "rgba(26, 33, 28, 0.9)"},
                  "olt:km": {"text-field": ["concat", ["number-format", ["get", "ele"], {"locale": "en-US"}], " m"]}}},

    {"id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
     "filter": ["!=", ["get", "brunnel"], "tunnel"],
     "paint": {"fill-color": "#a6cbe2"},
     "metadata": {"olt:dark": {"fill-color": "#13293a"}}},
    {"id": "waterway-river", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
     "filter": ["all", ["==", ["get", "class"], "river"], ["!=", ["get", "brunnel"], "tunnel"]],
     "layout": {"line-cap": "round"},
     "paint": {"line-color": "#78acd3", "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 8, 0.6, 12, 1.5, 16, 4]},
     "metadata": {"olt:dark": {"line-color": "#2c5877"}}},
    {"id": "waterway-stream", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 11,
     "filter": ["all", ["!=", ["get", "class"], "river"], ["!=", ["get", "brunnel"], "tunnel"]],
     "layout": {"line-cap": "round"},
     "paint": {"line-color": "#78acd3", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.4, 16, 1.5],
               "line-opacity": ["case", ["==", ["get", "intermittent"], 1], 0.55, 1]},
     "metadata": {"olt:dark": {"line-color": "#2c5877"}}},
    {"id": "park-outline", "type": "line", "source": "openmaptiles", "source-layer": "park", "minzoom": 7,
     "filter": ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
     "paint": {"line-color": "#6f9a5c", "line-opacity": 0.7, "line-dasharray": [3, 2],
               "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.6, 12, 1.2]},
     "metadata": {"olt:dark": {"line-color": "#5e8a55"}}},
    {"id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
     "paint": {"fill-color": "#dcd5c8"},
     "metadata": {"olt:dark": {"fill-color": "#2c312d"}}},

    {"id": "road-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 10,
     "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#c6baa5", "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 10, 1.8, 12, 3.6, 16, 11]},
     "metadata": {"olt:dark": {"line-color": "#0f1411"}}},
    {"id": "road-minor-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
     "filter": ["match", ["get", "class"], ["minor", "service"], true, false],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#d3cbbc", "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 12, 1.2, 16, 7]},
     "metadata": {"olt:dark": {"line-color": "#0f1411"}}},
    {"id": "road-track", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 11,
     "filter": ["==", ["get", "class"], "track"],
     "paint": {"line-color": "#8b7a62", "line-dasharray": [3, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.6, 16, 1.6]},
     "metadata": {"olt:dark": {"line-color": "#988b75"}}},
    {"id": "road-path", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
     "filter": ["==", ["get", "class"], "path"],
     "paint": {"line-color": "#695d4f", "line-dasharray": [2, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 16, 1.4]},
     "metadata": {"olt:dark": {"line-color": "#b1a690"}}},
    {"id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
     "filter": ["match", ["get", "class"], ["minor", "service"], true, false],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 12, 0.6, 16, 5]},
     "metadata": {"olt:dark": {"line-color": "#3c433e"}}},
    {"id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 9,
     "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 9, 0.5, 12, 2, 16, 9]},
     "metadata": {"olt:dark": {"line-color": "#4a514b"}}},
    {"id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
     "filter": ["match", ["get", "class"], ["primary", "trunk"], true, false],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#f2dfb0", "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 7, 0.5, 12, 2.5, 16, 10],
               "line-opacity": ["interpolate", ["linear"], ["zoom"], 7, 0.6, 9, 1]},
     "metadata": {"olt:dark": {"line-color": "#5b5747"}}},
    {"id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 5,
     "filter": ["==", ["get", "class"], "motorway"],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#e8c49a", "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 0.5, 8, 1.2, 12, 3, 16, 12],
               "line-opacity": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 8, 1]},
     "metadata": {"olt:dark": {"line-color": "#6b5c43"}}},
    {"id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 9,
     "filter": ["==", ["get", "class"], "rail"],
     "paint": {"line-color": "#a29e96", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.6, 16, 1.4]},
     "metadata": {"olt:dark": {"line-color": "#5b605b"}}},
    {"id": "boundary-state", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "minzoom": 3,
     "filter": ["all", ["==", ["get", "admin_level"], 4], ["!=", ["get", "maritime"], 1]],
     "paint": {"line-color": "#9a8ea2", "line-dasharray": [4, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.6, 10, 1.2]},
     "metadata": {"olt:dark": {"line-color": "#7a7389"}}},
    {"id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
     "filter": ["all", ["==", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], 1], ["!=", ["get", "disputed"], 1]],
     "layout": {"line-join": "round"},
     "paint": {"line-color": "#83788b", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.8, 10, 2]},
     "metadata": {"olt:dark": {"line-color": "#8f869c"}}},

    {"id": "waterway-label", "type": "symbol", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 12,
     "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
     "layout": {"symbol-placement": "line", "symbol-spacing": 400, "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
                "text-font": ["Noto Sans Italic"], "text-size": 11, "text-letter-spacing": 0.05},
     "paint": {"text-color": "#36678d", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#86b5d6", "text-halo-color": "rgba(26, 33, 28, 0.85)"}}},
    {"id": "water-label", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name",
     "filter": ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
     "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Italic"],
                "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 12, 12], "text-max-width": 7, "text-letter-spacing": 0.05},
     "paint": {"text-color": "#36678d", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#86b5d6", "text-halo-color": "rgba(26, 33, 28, 0.85)"}}},
    {"id": "park-label", "type": "symbol", "source": "openmaptiles", "source-layer": "park", "minzoom": 8,
     "filter": ["all", ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false], ["has", "name"]],
     "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Italic"],
                "text-size": 11, "text-max-width": 8, "text-padding": 8, "symbol-sort-key": ["coalesce", ["get", "rank"], 99]},
     "paint": {"text-color": "#3d6a37", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#94c58d", "text-halo-color": "rgba(26, 33, 28, 0.85)"}}},
    {"id": "road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 12,
     "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
     "layout": {"symbol-placement": "line", "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
                "text-font": ["Noto Sans Regular"], "text-size": 10.5},
     "paint": {"text-color": "#5c574d", "text-halo-color": "rgba(255, 255, 255, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#aaa392", "text-halo-color": "rgba(26, 33, 28, 0.85)"}}},
    {"id": "path-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 14,
     "filter": ["match", ["get", "class"], ["path", "track"], true, false],
     "layout": {"symbol-placement": "line", "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
                "text-font": ["Noto Sans Italic"], "text-size": 10},
     "paint": {"text-color": "#695d4f", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#b1a690", "text-halo-color": "rgba(26, 33, 28, 0.85)"}}},
    {"id": "poi-outdoor", "type": "symbol", "source": "openmaptiles", "source-layer": "poi", "minzoom": 13,
     "filter": ["match", ["get", "subclass"], ["camp_site", "alpine_hut", "wilderness_hut", "shelter"], true, false],
     "layout": {"icon-image": ["match", ["get", "subclass"], "camp_site", "campsite_11", "shelter", "shelter_11", "lodging_11"],
                "text-field": ["step", ["zoom"], "", 14, ["coalesce", ["get", "name_en"], ["get", "name"], ""]],
                "text-font": ["Noto Sans Regular"], "text-size": 10, "text-anchor": "top", "text-offset": [0, 0.8],
                "text-max-width": 8, "text-optional": true},
     "paint": {"text-color": "#5a4a3a", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#cdc2ab", "text-halo-color": "rgba(26, 33, 28, 0.85)", "icon-opacity": 0.85}}},
    {"id": "peak", "type": "symbol", "source": "openmaptiles", "source-layer": "mountain_peak", "minzoom": 9,
     "filter": ["all", ["match", ["get", "class"], ["peak", "volcano"], true, false], ["has", "name"]],
     "layout": {"text-field": ["format", "▲", {"font-scale": 0.85}, "\n", {}, ["coalesce", ["get", "name_en"], ["get", "name"]], {},
                               ["case", ["has", "ele_ft"], ["concat", "\n", ["number-format", ["get", "ele_ft"], {"locale": "en-US"}], " ft"], ""], {"font-scale": 0.85}],
                "text-font": ["Noto Sans Regular"], "text-size": 11, "text-anchor": "top", "text-offset": [0, -0.55],
                "text-line-height": 1.15, "text-max-width": 8, "text-padding": 6,
                "symbol-sort-key": ["-", 0, ["coalesce", ["get", "ele"], 0]]},
     "paint": {"text-color": "#4a3a29", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#ddd0b5", "text-halo-color": "rgba(26, 33, 28, 0.85)"},
                  "olt:km": {"text-field": ["format", "▲", {"font-scale": 0.85}, "\n", {}, ["coalesce", ["get", "name_en"], ["get", "name"]], {},
                                            ["case", ["has", "ele"], ["concat", "\n", ["number-format", ["get", "ele"], {"locale": "en-US"}], " m"], ""], {"font-scale": 0.85}]}}},
    {"id": "place-hamlet", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 12,
     "filter": ["match", ["get", "class"], ["hamlet", "locality", "isolated_dwelling"], true, false],
     "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"],
                "text-size": 10, "text-max-width": 8},
     "paint": {"text-color": "#4f5650", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#b4ad9b", "text-halo-color": "rgba(26, 33, 28, 0.85)"}}},
    {"id": "place-village", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 10,
     "filter": ["==", ["get", "class"], "village"],
     "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"],
                "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10.5, 14, 12], "text-max-width": 8},
     "paint": {"text-color": "#343a35", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#cfc8b6", "text-halo-color": "rgba(26, 33, 28, 0.85)"}}},
    {"id": "place-town", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 7,
     "filter": ["==", ["get", "class"], "town"],
     "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"],
                "text-size": ["interpolate", ["linear"], ["zoom"], 7, 10.5, 12, 13], "text-max-width": 8},
     "paint": {"text-color": "#2c322d", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.2},
     "metadata": {"olt:dark": {"text-color": "#ddd6c4", "text-halo-color": "rgba(26, 33, 28, 0.85)"}}},
    {"id": "place-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 4,
     "filter": ["==", ["get", "class"], "city"],
     "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"],
                "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 10, 15], "text-max-width": 8,
                "symbol-sort-key": ["coalesce", ["get", "rank"], 99]},
     "paint": {"text-color": "#232824", "text-halo-color": "rgba(242, 239, 230, 0.85)", "text-halo-width": 1.4},
     "metadata": {"olt:dark": {"text-color": "#e6dfcd", "text-halo-color": "rgba(26, 33, 28, 0.85)"}}},
    {"id": "place-state", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 4, "maxzoom": 8,
     "filter": ["==", ["get", "class"], "state"],
     "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Italic"],
                "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 8, 12], "text-transform": "uppercase",
